  "maximumS5Family": {
    "k": 5,
    "minimumN": 10,
    "valueLatex": "\\binom{N}{5}",
    "status": "proven",
    "stateKey": "coherent",
    "proofProvenance": "At N=10 the normalized fifth-sector operator on two symmetric copies has eigenvalues −256/63, −719/945, 13/21, −449/945, 26/45 and 1 at total spins 0,2,4,6,8,10. All are at most one, so S5≤C(10,5). Convexity extends this to mixed symmetric states, and symmetry of reduced states preserves S5/C(N,5), proving the same normalized bound for every N≥10. A coherent product state attains it. Thus the N=10 and N=11 entries are rigorously 252 and 462. The source also gives an exact N=9 counterexample to the coherent bound, establishing the sharp eventual threshold N0prime(5)=10.",
    "references": [
      {
        "sourceId": "threshold-certificates-2026",
        "url": "https://github.com/aenictusGitHub/n9-s8-exact-certificates/blob/a992fde3e73455f81445c872a442c640ddb6a11b/thresholds/maximum/PROOF.md",
