      "stateLatex": "\\sqrt{\\frac{23}{126}}|D_{10}^{(0)}\\rangle+\\sqrt{\\frac37}|D_{10}^{(3)}\\rangle+e^{i\\phi}\\sqrt{\\frac16}|D_{10}^{(6)}\\rangle+e^{i(\\phi+\\chi)}\\sqrt{\\frac29}|D_{10}^{(9)}\\rangle",
