  "proofs": {
    "schmidt-rank": {
      "title": "Schmidt-rank bound",
      "statement": "A pure symmetric n-qubit t-anticoherent state requires t≤floor(n/2).",
      "proof": "The t-body reduced state is I_sym^(t)/(t+1), of rank t+1. Its complementary symmetric subsystem has dimension n−t+1. Equality of the nonzero Schmidt spectra requires t+1≤n−t+1. Higher orders are excluded by nesting."
    },
    "odd-complement": {
      "title": "Odd-size complement obstruction",
      "statement": "No pure symmetric n=2t+1 qubit state is t-anticoherent when t≥2.",
      "proof": "For a hypothetical state, rho_t=I_sym^(t)/(t+1). The complementary rho_(t+1) has rank t+1 with equal nonzero eigenvalues in dimension t+2, hence rho_(t+1)=(I_sym^(t+1)−|phi><phi|)/(t+1). Since Tr_1 I_sym^(t+1)=(t+2)/(t+1) I_sym^(t), tracing one qubit forces Tr_1|phi><phi|=I_sym^(t)/(t+1). This reduced state has rank t+1>2, impossible for a pure (t+1)-qubit phi across the t-versus-one partition.",
      "provenance": "Catalogue deduction; independent of numerical absence reports."
    },
    "even-tensor-gram": {
      "title": "Orthogonal tensor-image dimension bound",
      "statement": "Pure t-anticoherence with t≥2q requires (q+1)^2≤n+1. In particular, n=12,t=6 is impossible.",
      "proof": "Take all orthonormal irreducible tensors T_LM with 0≤L≤q. Products T_LM†T_L′M′ have ranks at most 2q≤t. Anticoherence makes their expectations equal to those in I/(n+1), so the (q+1)^2 vectors T_LM|psi> are mutually orthogonal with nonzero squared norm 1/(n+1). They cannot fit in the (n+1)-dimensional symmetric Hilbert space when (q+1)^2>n+1. For n=12,q=3 this would require sixteen orthogonal nonzero vectors in dimension thirteen.",
      "provenance": "Catalogue deduction from standard orthonormal multipole decomposition."
    },
